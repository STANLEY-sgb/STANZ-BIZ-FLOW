# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://bizflow:change-me@localhost:5432/bizflow
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Comma-separated list of allowed browser origins (mobile apps do not need CORS)
CORS_ORIGINS=
# Email delivery: "log" (development only, prints nothing sensitive) or "smtp"
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
PUBLIC_APP_URL=https://app.example.com
